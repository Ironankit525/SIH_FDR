# Optional native backend overrides. Copy to backend/.env, never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./.data/depositflow.db
STORAGE_BACKEND=local
STORAGE_PATH=.data/documents
JOB_MODE=local
EXTRACTION_PROVIDER=ocr
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_LEASE_SECONDS=900
# OCR works without a model. For team VLM testing see docs/TEAM_TESTING.md.
# Optional Gemma 3 27B worker: run training/gemma3_27b/Gemma3_27B_Review_and_Serve.ipynb.
# Import current worker settings with: .venv/bin/python scripts/connect_vlm.py /path/to/backend-vlm.env
# EXTRACTION_PROVIDER=vlm_http
# VLM_ENDPOINT=https://your-worker-host/api/v1/extract-only
# VLM_API_KEY=replace-with-the-worker-session-key
# VLM_MODEL=unsloth/gemma-3-27b-it-unsloth-bnb-4bit
# VLM_MODEL_VERSION=replace-with-the-evaluated-adapter-fingerprint
# VLM_TIMEOUT_SECONDS=300
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
REQUIRE_MALWARE_SCAN=false
DEMO_PASSWORD=DemoFlow2026!
# Local keys are generated in .data/local-secrets.json when omitted.
# SECRET_KEY=
# STORAGE_ENCRYPTION_KEY=
# Native PostgreSQL alternative, if already installed:
# DATABASE_URL=postgresql+psycopg://depositflow:password@127.0.0.1:5432/depositflow
# Tesseract must be on PATH for scanned PDFs and images.
